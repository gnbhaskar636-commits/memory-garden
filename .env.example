# Copy to .env and fill in from your Supabase project
# (Project Settings -> API, Project Settings -> Database).

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres

# Optional — enables real AI memory analysis via OpenRouter.
# Without it, analysis falls back to a rule-based analyzer
# (see src/lib/ai/analyze.server.ts). The app never crashes if AI is unavailable.
OPENROUTER_API_KEY=
# Optional model override (default: openai/gpt-4o-mini).
# Examples: openai/gpt-4o-mini, anthropic/claude-3.5-haiku, google/gemini-2.0-flash-001
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional — site URL sent to OpenRouter for rankings (defaults to memory-garden.app).
# OPENROUTER_HTTP_REFERER=https://your-deployed-url.com
